<?xml version="1.0" encoding="utf-8"?>
<!-- Mandatory Layout Demonstration: ConstraintLayout for Forgot Password Screen -->
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/layoutForgotPasswordConstraint"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background"
    android:padding="@dimen/screen_padding"
    tools:context=".ForgotPasswordActivity">

    <!-- Header Illustration / Icon -->
    <ImageView
        android:id="@+id/imgForgotHeader"
        android:layout_width="@dimen/logo_size"
        android:layout_height="@dimen/logo_size"
        android:layout_marginTop="@dimen/spacing_xlarge"
        android:contentDescription="@string/cd_app_logo"
        android:src="@drawable/ic_lock"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:tint="@color/primary" />

    <!-- Screen Title -->
    <TextView
        android:id="@+id/tvForgotTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/spacing_large"
        android:text="@string/forgot_password_title"
        android:textColor="@color/on_background"
        android:textSize="@dimen/text_title_large"
        android:textStyle="bold"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/imgForgotHeader" />

    <!-- Instruction Subtitle -->
    <TextView
        android:id="@+id/tvForgotInstruction"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/spacing_small"
        android:gravity="center"
        android:text="@string/forgot_password_instruction"
        android:textColor="@color/subtitle_color"
        android:textSize="@dimen/text_body_medium"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tvForgotTitle" />

    <!-- Form Card -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/cardForgotForm"
        style="@style/Widget.CampusConnect.Card"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/spacing_xlarge"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tvForgotInstruction">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="@dimen/spacing_large">

            <!-- Email Input Control: textEmailAddress -->
            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/tilForgotEmail"
                style="@style/Widget.CampusConnect.TextInputLayout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="@string/email_hint"
                app:startIconDrawable="@drawable/ic_email">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/etForgotEmail"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="textEmailAddress"
                    android:maxLines="1" />
            </com.google.android.material.textfield.TextInputLayout>

            <!-- Send Reset Link Button -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnSendResetLink"
                style="@style/Widget.CampusConnect.Button"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_large"
                android:text="@string/btn_send_reset_link" />

        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <!-- Back to Login Link -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnForgotBackToLogin"
        style="@style/Widget.CampusConnect.Button.TextButton"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/spacing_medium"
        android:text="@string/link_back_to_login"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/cardForgotForm" />

</androidx.constraintlayout.widget.ConstraintLayout>
