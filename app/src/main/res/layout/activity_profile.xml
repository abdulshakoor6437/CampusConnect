<?xml version="1.0" encoding="utf-8"?>
<!-- Mandatory Layout Demonstration: ConstraintLayout for Profile Screen -->
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/layoutProfileConstraint"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background"
    tools:context=".ProfileActivity">

    <!-- Top Toolbar -->
    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbarProfile"
        style="@style/Widget.CampusConnect.Toolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:navigationIcon="@drawable/ic_arrow_back"
        app:navigationIconTint="@color/on_surface"
        app:title="@string/profile_title" />

    <!-- Avatar Container -->
    <ImageView
        android:id="@+id/imgProfileAvatar"
        android:layout_width="@dimen/avatar_size"
        android:layout_height="@dimen/avatar_size"
        android:layout_marginTop="@dimen/spacing_large"
        android:background="@drawable/bg_circle_avatar"
        android:contentDescription="@string/cd_profile_avatar"
        android:padding="@dimen/spacing_medium"
        android:src="@drawable/ic_profile"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/toolbarProfile"
        app:tint="@color/primary" />

    <!-- User Full Name Header -->
    <TextView
        android:id="@+id/tvProfileNameHeader"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/spacing_medium"
        android:textColor="@color/on_background"
        android:textSize="@dimen/text_title_large"
        android:textStyle="bold"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/imgProfileAvatar"
        tools:text="Alex Johnson" />

    <!-- User Role Badge -->
    <TextView
        android:id="@+id/tvProfileRoleBadge"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/spacing_micro"
        android:background="@drawable/bg_circle_avatar"
        android:paddingStart="@dimen/spacing_medium"
        android:paddingTop="@dimen/spacing_micro"
        android:paddingEnd="@dimen/spacing_medium"
        android:paddingBottom="@dimen/spacing_micro"
        android:text="@string/role_student"
        android:textColor="@color/primary"
        android:textSize="@dimen/text_label"
        android:textStyle="bold"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tvProfileNameHeader" />

    <!-- Profile Details Card -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/cardProfileDetails"
        style="@style/Widget.CampusConnect.Card"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/screen_padding"
        android:layout_marginTop="@dimen/spacing_large"
        android:layout_marginEnd="@dimen/screen_padding"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tvProfileRoleBadge">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="@dimen/spacing_large">

            <!-- Name Detail Row -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/label_user_name"
                android:textColor="@color/subtitle_color"
                android:textSize="@dimen/text_label" />

            <TextView
                android:id="@+id/tvProfileDetailName"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_micro"
                android:textColor="@color/on_surface"
                android:textSize="@dimen/text_body_large"
                android:textStyle="bold"
                tools:text="Alex Johnson" />

            <!-- Divider -->
            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginTop="@dimen/spacing_medium"
                android:layout_marginBottom="@dimen/spacing_medium"
                android:background="@color/card_stroke" />

            <!-- Email Detail Row -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/label_user_email"
                android:textColor="@color/subtitle_color"
                android:textSize="@dimen/text_label" />

            <TextView
                android:id="@+id/tvProfileDetailEmail"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_micro"
                android:textColor="@color/on_surface"
                android:textSize="@dimen/text_body_large"
                android:textStyle="bold"
                tools:text="user@example.com" />

            <!-- Divider -->
            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginTop="@dimen/spacing_medium"
                android:layout_marginBottom="@dimen/spacing_medium"
                android:background="@color/card_stroke" />

            <!-- Institution Row -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/label_institution"
                android:textColor="@color/subtitle_color"
                android:textSize="@dimen/text_label" />

            <TextView
                android:id="@+id/tvProfileDetailInstitution"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_micro"
                android:text="@string/institution_name"
                android:textColor="@color/on_surface"
                android:textSize="@dimen/text_body_large"
                android:textStyle="bold" />

        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <!-- Logout Button -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnLogout"
        style="@style/Widget.CampusConnect.Button.Outlined"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/screen_padding"
        android:layout_marginEnd="@dimen/screen_padding"
        android:layout_marginBottom="@dimen/spacing_large"
        android:strokeColor="@color/error"
        android:text="@string/btn_logout"
        android:textColor="@color/error"
        app:icon="@drawable/ic_logout"
        app:iconGravity="textStart"
        app:iconTint="@color/error"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>
