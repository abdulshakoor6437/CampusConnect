    <string name="help_faq_header">Frequently Asked Questions</string>
    <string name="help_q1">How do I register for new semester courses?</string>
    <string name="help_a1">Navigate to the Courses module on your dashboard during open registration or consult your academic advisor.</string>
    <string name="help_q2">Where can I view my latest grade reports?</string>
    <string name="help_a2">Open the Reports section from your dashboard to view your attendance percentage, cumulative GPA, and course credits.</string>
    <string name="help_q3">How do I update my profile details?</string>
    <string name="help_a3">Tap on the Profile card on your dashboard or the profile icon in the toolbar to review your account details.</string>
    <string name="help_q4">How do I enable Dark Mode?</string>
    <string name="help_a4">Visit Settings from the dashboard and toggle the Dark Mode switch to immediately apply the dark theme.</string>
    <string name="help_q5">Who do I contact for technical or academic support?</string>
    <string name="help_a5">You can contact our campus help desk anytime using the Contact Support button below or via email.</string>
